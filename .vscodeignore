# Every harness folder stays out except the Cursor plugin, which the extension registers in Cursor.
# Listed part by part: vsce lets a ! line win over any later exclusion, so the dev note there stays out.
views/**
!views/cursor/.cursor-plugin/**
!views/cursor/assets/**
!views/cursor/commands/**
!views/cursor/dist/**
!views/cursor/rules/**
!views/cursor/skills/**
!views/cursor/ui/**
!views/cursor/mcp.json
!views/cursor/README.md

