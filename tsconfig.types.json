// Declaration-only build for the @refined/taskplanner library entry point.
// esbuild bundles src/core/index.ts to packages/mcp-server/dist/index.js; tsc emits the matching
// .d.ts tree next to it so TypeScript consumers get types. Run via `npm run build:types`.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src/core",
    "outDir": "packages/mcp-server/dist",
    "emitDeclarationOnly": true,
    "declaration": true,
    // The sources are not published, so maps would point at files the consumer does not have.
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/core/**/*.ts"],
  "exclude": ["src/test/**/*.ts", "node_modules", "dist"]
}
